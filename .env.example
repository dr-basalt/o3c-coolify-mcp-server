# Sample environment configuration
# Copy this file to .env and fill in your values

# Required: Coolify API configuration
COOLIFY_API_URL=https://your-coolify-instance.com
COOLIFY_API_TOKEN=your-api-token-here

# Server configuration
PORT=3000
HOST=0.0.0.0

# Transport: sse, streamable, or stdio
TRANSPORT=sse

# Logging
LOG_LEVEL=info
# LOG_FILE=/var/log/mcp-server.log  # Only used in stdio mode

# CORS (for web clients)
CORS_ORIGIN=*

# Production settings
NODE_ENV=production
