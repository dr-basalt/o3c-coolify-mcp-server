{
  "name": "o3c-coolify-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Coolify API - deployable as web service (SSE/Streamable) or stdio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:sse": "node dist/index.js --transport sse",
    "start:streamable": "node dist/index.js --transport streamable",
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "dev:sse": "tsx src/index.ts --transport sse",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "coolify-mcp": "./dist/index.js"
  },
  "keywords": [
    "mcp",
    "coolify",
    "model-context-protocol",
    "ai",
    "deployment",
    "sse",
    "streamable"
  ],
  "author": "O3C",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "zod": "^3.23.8",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "eslint": "^9.14.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
